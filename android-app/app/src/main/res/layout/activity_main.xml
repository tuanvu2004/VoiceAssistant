<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false"
    android:fitsSystemWindows="true">

    <!-- 1. THANH ĐẦU TRANG: Lịch sử - Nhận diện AI - Cài đặt -->
    <ImageButton
        android:id="@+id/btnLichSu"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_glass_circle"
        android:contentDescription="Lịch sử"
        android:padding="11dp"
        android:src="@drawable/ic_history"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/text_primary" />

    <!-- Viên thuốc nhận diện thương hiệu AI ở chính giữa đỉnh màn hình -->
    <LinearLayout
        android:id="@+id/pillAiIdentity"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:background="@drawable/bg_ai_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="9dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@id/btnLichSu"
        app:layout_constraintEnd_toStartOf="@id/btnCaiDat"
        app:layout_constraintStart_toEndOf="@id/btnLichSu"
        app:layout_constraintTop_toTopOf="@id/btnLichSu">

        <FrameLayout
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_ai_badge_circle">

            <ImageView
                android:id="@+id/ivAiSparkle"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_ai_sparkle" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAiName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.02"
                android:text="Aura AI"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAiSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lõi Lụa 3D • Chạm đổi"
                android:textColor="@color/fire_amber"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnCaiDat"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_glass_circle"
        android:contentDescription="Cài đặt"
        android:padding="11dp"
        android:src="@drawable/ic_settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/text_primary" />

    <!-- 2. SÂN KHẤU NHẬN DIỆN AI 3D ĐA CHIỀU Ở TRUNG TÂM -->
    <com.tuanvu.voiceassistant.AiStageView
        android:id="@+id/aiStage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toTopOf="@id/glDuoi"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pillAiIdentity" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/glDuoi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.54" />

    <!-- 3. TIÊU ĐỀ PHẢN HỒI AI & ĐỒNG HỒ THU ÂM -->
    <TextView
        android:id="@+id/tvTieuDeChinh"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:letterSpacing="0.01"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="Tôi có thể giúp gì cho bạn?"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/glDuoi" />

    <TextView
        android:id="@+id/tvThoiGian"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0"
        android:fontFamily="sans-serif-light"
        android:letterSpacing="0.1"
        android:text="00:00"
        android:textColor="@color/text_primary"
        android:textSize="36sp"
        app:layout_constraintBottom_toBottomOf="@id/tvTieuDeChinh"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvTieuDeChinh" />

    <TextView
        android:id="@+id/tvTrangThai"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:letterSpacing="0.03"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="Chạm micro để nói • Vuốt tâm 3D để xoay"
        android:textColor="@color/text_secondary"
        android:textSize="14.5sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTieuDeChinh" />

    <!-- 4. KHU VỰC ĐIỀU KHIỂN MICRO & PHÍM CHỨC NĂNG ĐÁY -->
    <View
        android:layout_width="340dp"
        android:layout_height="340dp"
        android:background="@drawable/bg_bottom_glow"
        app:layout_constraintBottom_toBottomOf="@id/micFrame"
        app:layout_constraintEnd_toEndOf="@id/micFrame"
        app:layout_constraintStart_toStartOf="@id/micFrame"
        app:layout_constraintTop_toTopOf="@id/micFrame" />

    <FrameLayout
        android:id="@+id/micFrame"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.tuanvu.voiceassistant.MicButton
            android:id="@+id/btnMic"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:contentDescription="Nói chuyện với trợ lý"
            android:padding="84dp"
            android:src="@drawable/ic_mic" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/btnKho"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="30dp"
        android:background="@drawable/bg_glass_circle"
        android:contentDescription="Kho giọng nói"
        android:padding="14dp"
        android:src="@drawable/ic_warehouse"
        app:layout_constraintBottom_toBottomOf="@id/micFrame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/micFrame"
        app:tint="@color/text_primary" />

    <ImageButton
        android:id="@+id/btnDong"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="30dp"
        android:background="@drawable/bg_glass_circle"
        android:contentDescription="Dừng"
        android:padding="15dp"
        android:src="@drawable/ic_close"
        app:layout_constraintBottom_toBottomOf="@id/micFrame"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/micFrame"
        app:tint="@color/text_primary" />
</androidx.constraintlayout.widget.ConstraintLayout>
